{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "overrides": [
    {
      // React Three Fiber mutates three.js objects inside useFrame on purpose (that is its API),
      // and scatter data is generated once in useMemo. These React-Compiler style rules don't fit.
      "files": ["src/world/**"],
      "rules": {
        "react/immutability": "off",
        "react/purity": "off",
        "react/only-export-components": "off"
      }
    },
    {
      // exported map-drawing helpers live next to their component on purpose
      "files": ["src/ui/DriveHud.tsx"],
      "rules": { "react/only-export-components": "off" }
    }
  ]
}
